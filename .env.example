# Copy to .env and replace all secrets before running Docker Compose.
# Use letters, digits and hyphens in POSTGRES_PASSWORD (embedded in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-a-unique-local-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MINIO_ROOT_USER=roomforge
MINIO_ROOT_PASSWORD=replace-with-a-unique-local-storage-password
DATABASE_URL=postgres://roomforge:replace-with-a-unique-local-database-password@localhost:5432/roomforge
API_HOST=127.0.0.1
API_PORT=8080
CORS_ORIGIN=http://localhost:5173
RUST_LOG=roomforge_api=info,tower_http=info

# Existing registered owner to promote on API startup (leave empty for no promotion).
ADMIN_EMAIL=
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=roomforge
STORAGE_SECRET_KEY=replace-with-your-storage-password
STORAGE_BUCKET=roomforge-assets
STORAGE_REGION=us-east-1
ASSET_MAX_BYTES=20971520
ASSET_MAX_TRIANGLES=150000
OPTIMIZER_SCRIPT=tools/optimize-model.mjs
NODE_BINARY=node
